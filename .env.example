# Home location: used whenever a tool is called without naming a place.
#
# Coordinates rather than a name, on purpose. A name would be re-geocoded on
# every call, and re-resolved -- so a change in how Open-Meteo ranks "Austin"
# could silently move home from Texas to Minnesota. Run search_locations once
# and paste the numbers.
WEATHER_MCP_HOME=40.7128,-74.0060
WEATHER_MCP_HOME_NAME=New York
# WEATHER_MCP_HOME_TIMEZONE=America/New_York

# --- Units (all optional; defaults shown) ---
# WEATHER_MCP_TEMPERATURE_UNIT=fahrenheit
# WEATHER_MCP_WIND_SPEED_UNIT=mph
# WEATHER_MCP_PRECIPITATION_UNIT=inch

# --- HTTP transport (all optional; stdio is the default) ---
# WEATHER_MCP_TRANSPORT=http
# WEATHER_MCP_HOST=127.0.0.1
# WEATHER_MCP_PORT=18791
# WEATHER_MCP_STATELESS=true

# --- Authentication, HTTP transport only ---
# WEATHER_MCP_AUTH=password
# WEATHER_MCP_PASSWORD=a-long-random-value
# WEATHER_MCP_BASE_URL=https://weather.example.com
# WEATHER_MCP_STATE_DIR=~/.weather-mcp
